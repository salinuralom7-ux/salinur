# ---------------------------------------------------------------------------
# Budget Phone Store — environment
#
# These belong to the shop's own Razorpay account, registered to
# budgetphonestorebongaigaon@gmail.com. Nothing here is shared with any other
# project or personal account.
#
# Copy to .env.local for local work, and set the same names in the hosting
# dashboard for production. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Server only. These must never reach the browser. ----------------------
# Razorpay Dashboard -> Settings -> API Keys -> Generate Key.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Browser. Anything prefixed VITE_ is public by design. -----------------
# auto (default) — use the real gateway when the server has keys, otherwise run
#                  a clearly-labelled test mode so the shop stays usable.
# live           — never fall back; fail loudly if the gateway is unreachable.
# demo           — never contact Razorpay at all.
#
# Set this to `live` once the merchant account is active.
VITE_PAYMENTS_MODE=auto

# Optional: point `npm run dev` at a running `vercel dev` so the /api routes
# resolve during local development.
# VITE_API_PROXY=http://localhost:3000
