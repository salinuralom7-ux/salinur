# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is git-ignored.

# Support email shown on Contact, Privacy, Terms and Refund pages (required by Play Store and Razorpay).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public URL of the site (used for SEO, Open Graph and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://influji.in

# --- Supabase ---  (step-by-step: SUPABASE-SETUP.md)
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects: "anon" key). Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service_role key. Server-only: account deletion and the payment webhook. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Turn on only after DLT-registered SMS is set up in Supabase → Auth → Phone.
NEXT_PUBLIC_PHONE_LOGIN=false

# --- Razorpay (step 5, test mode first) ---
# Razorpay dashboard → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Subscriptions → Plans. Create both plans there:
RAZORPAY_PLAN_ID_MONTHLY=   # ₹99 every 1 month
RAZORPAY_PLAN_ID_YEARLY=    # ₹594 every 1 year
# Razorpay dashboard → Webhooks (secret you set when adding the webhook)
RAZORPAY_WEBHOOK_SECRET=

# --- Android app (Play Store) ---  (see android/PLAY-STORE.md)
ANDROID_PACKAGE_ID=in.influji.app
# Play Console → Test and release → App integrity: the "App signing key" AND "Upload key" SHA-256, comma-separated.
ANDROID_SHA256_FINGERPRINTS=
