# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is git-ignored.

# Public URL of the site (used for SEO, Open Graph and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (step 2) ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (step 5, test mode first) ---
# Razorpay dashboard → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Subscriptions → Plans. Create both plans there:
RAZORPAY_PLAN_ID_MONTHLY=   # ₹99 every 1 month
RAZORPAY_PLAN_ID_YEARLY=    # ₹499 every 1 year
# Razorpay dashboard → Webhooks (secret you set when adding the webhook)
RAZORPAY_WEBHOOK_SECRET=
